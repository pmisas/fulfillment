aws_region   = "us-east-1"
project_name = "fulfillment"

lambda_artifacts_bucket   = "fulfillment-lambda-artifacts"
events_publisher_s3_key   = "lambdas/events-publisher/events-publisher-lambda.jar"
notification_lambda_s3_key = "lambdas/notification/notification-lambda.jar"

shipping_guides_bucket_name = "fulfillment-shipping-guides"

outbox_publisher_schedule_expression = "rate(1 minute)"

cognito_user_pool_id  = "us-east-1_xxxxxxxxx"
cognito_user_pool_arn = "arn:aws:cognito-idp:us-east-1:123456789012:userpool/us-east-1_xxxxxxxxx"
ses_from_email        = "no-reply@example.com"

# Leave empty to skip EC2 security groups until you have a VPC selected.
vpc_id = ""

public_http_cidr_blocks = ["0.0.0.0/0"]
ssh_cidr_blocks         = []
